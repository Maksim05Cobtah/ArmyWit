@model ArmiVit.Models.ViewsModel.CategoryViewModel

@{
    ViewData["Title"] = "Додати категорію";
}

<section class="product-section">
    <div class="glass-card form-glass">
        <h2 class="title">Додати категорію</h2>

        <form method="post" asp-action="AddCategory">
            <div class="field">
                <label asp-for="Name">Назва категорії</label>
                <input asp-for="Name" class="form-control" placeholder="Назва категорії" required/>
            </div>

            <button type="submit" class="glass-btn">
                Зберегти
            </button>
        </form>
    </div>
</section>

<section class="products-container">
    <div class="products-grid">

        @foreach (var item in Model.Categories)
         {   @if (item.IsDeleted == false)
            {<div class="product-glass">
                <div class="product-content">
                    <h3>@item.Name</h3>
                </div>

                <div class="product-actions">
                    <a asp-controller="Categories"
                       asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn-edit" title="Редагувати">
                        <span class="icon">✏️</span>
                        <span>Редагувати</span>
                    </a>

                    <form method="post" asp-controller="Categories" asp-action="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Точно видалити цю категорію?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-delete" title="Видалити">
                            <span class="icon">🗑️</span>
                            <span>Видалити</span>
                        </button>
                    </form>
                </div>
            </div>}
        }

    </div>
</section>