@model List<ArmiVit.Models.TrainingProgram>
@{
    ViewData["Title"] = "Про мене";
    // Тут перевірка прав доступу (наприклад, ) або потрібна вам логіка)
    bool isAdmin = User.IsInRole("Admin"); 
}

<!-- Підключаємо іконки Lucide -->
<script src="https://unpkg.com/lucide@latest"></script>

<!-- Моноширинний шрифт з Google Fonts (JetBrains Mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet">

<style>
    /* ==========================================
       1. ГЛОБАЛЬНІ СТИЛІ ТА АНІМОВАНИЙ ФОН
       ========================================== */
    * {
        font-family: 'JetBrains Mono', monospace !important;
    }

    .about-page-body {
        position: relative;
        background: linear-gradient(-45deg, #fcfaf0, #f3edf8, #ebf3f5, #f8f4ed);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: #222222;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    @@keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    
    .about-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* ==========================================
       2. АНІМАЦІЇ ПРИ СКРОЛІ
       ========================================== */
    .animate-on-scroll {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .animate-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }

    /* ==========================================
       3. СТИЛІ СЕКЦІЙ ТА КАРТОК
       ========================================== */
    .section-title-badge {
        background-color: #A797D2;
        border-radius: 16px;
        padding: 16px 24px;
        text-align: center;
        margin-bottom: 40px;
        box-shadow: 0 8px 20px rgba(167, 151, 210, 0.25);
        position: relative;
    }
    .section-title-badge h2 {
        font-weight: 800;
        font-size: 24px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #ffffff;
        margin: 0;
    }

    .section-title-plain {
        font-weight: 800;
        font-size: 28px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #A797D2;
        text-align: center;
        margin-bottom: 40px;
    }

    .content-card {
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }

    /* HERO СЕКЦІЯ */
    .hero-section {
        position: relative;
        height: 85vh;
        min-height: 500px;
        background-color: #000;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
    }
    .hero-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        filter: grayscale(100%);
        opacity: 0.9;
        transition: transform 6s ease;
    }
    .hero-section:hover .hero-image {
        transform: scale(1.04);
    }
    .hero-title-container {
        position: relative;
        z-index: 10;
        max-width: 1000px;
        width: 100%;
        margin: 0 auto;
        padding: 0 40px 60px 40px;
    }
    .hero-title-container h1 {
        font-weight: 800;
        font-size: 52px;
        color: #ffffff;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0;
        text-shadow: 0 4px 20px rgba(0,0,0,0.6);
    }

    /* ПРО МЕНЕ */
    .about-layout {
        display: flex;
        align-items: center;
        gap: 40px;
    }
    .about-avatar {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        transition: transform 0.4s ease;
    }
    .about-avatar:hover {
        transform: scale(1.06) rotate(3deg);
    }
    .about-text {
        font-size: 16px;
        line-height: 1.7;
        color: #333333;
    }

    /* ДОСВІД */
    .experience-text p {
        font-size: 16px;
        line-height: 1.7;
        color: #444444;
        margin-bottom: 24px;
    }
    .quote-box {
        position: relative;
        border: 1px solid #EAEAEA;
        border-radius: 20px;
        padding: 28px;
        margin-top: 32px;
        background-color: #ffffff;
        transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }
    .quote-box:hover {
        border-color: #A797D2;
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(167, 151, 210, 0.15);
    }
    .quote-box p {
        font-size: 15px;
        line-height: 1.6;
        color: #444444;
        margin-bottom: 12px;
    }
    .quote-icon {
        position: absolute;
        top: 24px;
        right: 24px;
        color: #A797D2;
    }
    .time-stamp {
        text-align: right;
        font-size: 12px;
        color: #B0B0B0;
    }

    /* СЕРТИФІКАТИ */
    .certificates-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        margin-bottom: 32px;
    }
    .certificate-item {
        background-color: #A797D2;
        border-radius: 20px;
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
        cursor: pointer;
        position: relative;
    }
    .certificate-item:hover {
        transform: translateY(-6px);
        background-color: #9684C5;
        box-shadow: 0 12px 30px rgba(167, 151, 210, 0.35);
    }
    .certificate-item p {
        font-weight: 700;
        font-size: 14px;
        text-transform: uppercase;
        color: #ffffff;
        margin: 0;
        line-height: 1.5;
    }
    .disclaimer-bar {
        background-color: #C2B7E3;
        border-radius: 16px;
        padding: 18px 24px;
        text-align: center;
    }
    .disclaimer-bar p {
        font-weight: 800;
        font-size: 14px;
        text-transform: uppercase;
        color: #000000;
        margin: 0;
    }

    /* ПОСЛУГИ ТА КНОПКИ ЦІН */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }
    .service-card {
        background-color: #ffffff;
        border-radius: 24px;
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }
    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.08);
    }
    .service-card h3 {
        font-weight: 800;
        font-size: 16px;
        text-transform: uppercase;
        margin-top: 0;
        margin-bottom: 24px;
        color: #111111;
        line-height: 1.4;
    }
    .service-label {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: #A797D2;
        margin-bottom: 12px;
    }
    .service-list {
        list-style: none;
        padding: 0;
        margin: 0 0 24px 0;
    }
    .service-list li {
        font-size: 14px;
        line-height: 1.5;
        color: #444444;
        margin-bottom: 10px;
    }
    .service-list.bullets li {
        position: relative;
        padding-left: 16px;
    }
    .service-list.bullets li::before {
        content: "•";
        position: absolute;
        left: 0;
        color: #A797D2;
    }
    .service-price-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background-color: #A797D2;
        color: #ffffff !important;
        font-weight: 800;
        font-size: 18px;
        letter-spacing: 1px;
        text-align: center;
        padding: 14px 0;
        border-radius: 25px;
        margin-top: 20px;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        box-shadow: 0 4px 15px rgba(167, 151, 210, 0.3);
        transition: all 0.3s ease;
    }
    .service-price-btn:hover {
        background-color: #9684C5;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(167, 151, 210, 0.4);
    }

    /* СУПРОВІД */
    .support-box {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
        background-color: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .support-card-item {
        padding: 44px;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: background-color 0.3s ease;
        position: relative;
    }
    .support-card-item:hover {
        background-color: #FAF8FF;
    }
    .support-card-item:first-child {
        border-right: 1px solid #F0F0F0;
    }
    .support-card-item h3 {
        font-weight: 800;
        font-size: 24px;
        margin-top: 0;
        margin-bottom: 20px;
    }
    .program-badge {
        border: 1.5px solid #A797D2;
        border-radius: 20px;
        padding: 6px 20px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: #A797D2;
        margin-bottom: 28px;
    }

    /* КНОПКИ З ВІДБЛИСКОМ СВІТЛА */
    .animated-btn {
        position: relative;
        width: 100%;
        background-color: #C2B7E3;
        color: #ffffff !important;
        font-weight: 800;
        font-size: 18px;
        text-align: center;
        padding: 16px 0;
        border-radius: 14px;
        margin-top: auto;
        border: none;
        cursor: pointer;
        overflow: hidden;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .animated-btn::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -60%;
        width: 20%;
        height: 200%;
        background: rgba(255, 255, 255, 0.4);
        transform: rotate(30deg);
        transition: all 0.6s ease;
    }
    .animated-btn:hover::after {
        left: 120%;
    }
    .animated-btn:hover {
        background-color: #A797D2;
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 10px 25px rgba(167, 151, 210, 0.4);
    }

    /* ПАКЕТНІ ПРОПОЗИЦІЇ (ПО СЕРЕДИНІ) */
    .package-content-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin: 0 auto;
    }
    .package-main-badge {
        border: 2px solid #A797D2;
        border-radius: 20px;
        padding: 10px 32px;
        font-weight: 800;
        font-size: 16px;
        text-transform: uppercase;
        display: inline-block;
        margin-bottom: 32px;
    }
    .package-details-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 420px;
    }
    .package-tag {
        display: inline-block;
        background-color: #C2B7E3;
        color: #ffffff !important;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 6px 20px;
        border-radius: 12px;
        margin-bottom: 16px;
        text-align: center;
        text-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }
    .package-details-group .service-list {
        text-align: left;
        width: 100%;
        margin-bottom: 24px;
    }
    .package-price-text {
        text-align: center;
        font-weight: 800;
        font-size: 28px;
        color: #222222;
        margin-top: 20px;
        padding-top: 24px;
        border-top: 1px solid #F0F0F0;
        width: 100%;
    }

    /* КОНТАКТИ */
    .contacts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 32px;
    }
    .contact-item {
        display: flex;
        align-items: center;
        gap: 20px;
        text-decoration: none;
        padding: 12px;
        border-radius: 20px;
        transition: background-color 0.3s ease, transform 0.2s ease;
        position: relative;
    }
    .contact-item:hover {
        background-color: rgba(255, 255, 255, 0.6);
        transform: translateX(5px);
    }

    .contact-icon-box {
        width: 60px;
        height: 60px;
        background-color: #E2E2E2;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666666;
        flex-shrink: 0;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .contact-icon-box svg {
        width: 28px;
        height: 28px;
        fill: currentColor;
        transition: fill 0.3s ease, stroke 0.3s ease;
    }
    
    .contact-label {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: #B0B0B0;
        margin-bottom: 4px;
    }
    .contact-value {
        font-size: 15px;
        font-weight: 700;
        color: #222222;
    }

    /* INSTAGRAM */
    .contact-item.instagram:hover .contact-icon-box {
        border-radius: 18px;
        background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
        color: #ffffff;
        transform: scale(1.1) rotate(-4deg);
        box-shadow: 0 10px 25px rgba(214, 36, 159, 0.4);
    }

    /* FACEBOOK */
    .contact-item.facebook:hover .contact-icon-box {
        border-radius: 50%;
        background-color: #1877F2;
        color: #ffffff;
        transform: scale(1.1) rotate(4deg);
        box-shadow: 0 10px 25px rgba(24, 119, 242, 0.4);
    }

    /* PHONE & EMAIL */
    .contact-item.phone:hover .contact-icon-box,
    .contact-item.email:hover .contact-icon-box {
        background-color: #A797D2;
        color: #ffffff;
        transform: scale(1.1);
        box-shadow: 0 10px 25px rgba(167, 151, 210, 0.4);
    }

    /* ==========================================
       4. СТИЛІ РЕЖИМУ КОНСТРУКТОРА (EDIT MODE)
       ========================================== */
    body.is-edit-mode [contenteditable="true"] {
        outline: 2px dashed #A797D2 !important;
        outline-offset: 4px;
        border-radius: 6px;
        transition: outline 0.2s ease;
    }
    body.is-edit-mode [contenteditable="true"]:focus {
        outline: 2px solid #8167C1 !important;
        background-color: rgba(167, 151, 210, 0.1);
    }

    body.is-edit-mode .service-card,
    body.is-edit-mode .certificate-item,
    body.is-edit-mode .support-card-item,
    body.is-edit-mode .contact-item {
        border: 1px dashed #A797D2;
    }

    /* Кнопки видалення та перетягування карток */
    .card-controls {
        display: none;
        position: absolute;
        top: 10px;
        right: 10px;
        gap: 6px;
        z-index: 50;
    }
    body.is-edit-mode .service-card:hover .card-controls,
    body.is-edit-mode .certificate-item:hover .card-controls,
    body.is-edit-mode .support-card-item:hover .card-controls,
    body.is-edit-mode .contact-item:hover .card-controls {
        display: flex;
    }

    .card-btn-delete {
        background: #FF5A5A;
        color: white;
        border: none;
        border-radius: 50%;
        width: 26px;
        height: 26px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .card-btn-delete:hover { background: #E03E3E; }

    /* Плаваюча панель інспектора кольорів та розміру */
    .inspector-panel {
        display: none;
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1002;
        background: #ffffff;
        border-radius: 30px;
        padding: 10px 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.18);
        border: 1px solid #EAEAEA;
        align-items: center;
        gap: 20px;
    }
    body.is-edit-mode .inspector-panel.active {
        display: flex;
    }
    .inspector-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 700;
        color: #444;
    }
    .inspector-item input[type="color"] {
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        cursor: pointer;
        background: none;
    }

    /* ==========================================
       5. СТИЛІ АДМІН-ПАНЕЛІ
       ========================================== */
    .admin-toggle-btn {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 1000;
        background-color: #A797D2;
        color: white;
        border: none;
        border-radius: 50%;
        width: 48px;
        height: 48px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        transition: transform 0.3s ease;
    }
    .admin-toggle-btn:hover { transform: scale(1.1) rotate(45deg); }

    .admin-sidebar {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 1001;
        width: 300px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        border: 1px solid #EEE;
        overflow: hidden;
        animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.9) translateY(-10px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .admin-header {
        padding: 16px 20px;
        border-bottom: 1px solid #EEE;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .admin-header h3 {
        margin: 0;
        font-size: 12px;
        text-transform: uppercase;
        color: #A797D2;
        font-weight: 800;
    }
    .admin-edit-btn-box { padding: 12px 16px; border-bottom: 1px solid #EEE; }
    .admin-edit-btn {
        width: 100%;
        background-color: #F5F5F5;
        border: none;
        padding: 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 800;
        color: #444;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    .admin-edit-btn.active {
        background-color: #A797D2;
        color: white;
        box-shadow: 0 4px 12px rgba(167, 151, 210, 0.3);
    }
    .admin-menu-list { padding: 8px; max-height: 400px; overflow-y: auto; }
    .admin-menu-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
        color: #444;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .admin-menu-item:hover { background-color: #F8F6FD; color: #A797D2; }
    .admin-menu-actions { display: flex; gap: 8px; align-items: center; }
    .admin-menu-actions i { cursor: pointer; opacity: 0.6; transition: opacity 0.2s; }
    .admin-menu-actions i:hover { opacity: 1; }

    @@media (max-width: 850px) {
        .services-grid, .support-box, .certificates-grid, .contacts-grid { grid-template-columns: 1fr; }
        .support-card-item:first-child { border-right: none; border-bottom: 1px solid #F0F0F0; }
        .hero-title-container h1 { font-size: 36px; }
        .about-layout { flex-direction: column; text-align: center; }
    }
</style>

<div class="about-page-body" id="page-sections-container">

    @if (isAdmin)
    {
        <!-- 1. КНОПКА ШЕСТЕРНІ (ТІЛЬКИ ДЛЯ АДМІНІСТРАТОРА) -->
        <button id="admin-open-btn" onclick="toggleAdminPanel(true)" class="admin-toggle-btn" title="Панель керування">
            <i data-lucide="settings" style="width: 22px; height: 22px;"></i>
        </button>

        <!-- 2. БІЧНА ПАНЕЛЬ РЕДАКТОРА СТРУКТУРИ (ТІЛЬКИ ДЛЯ АДМІНІСТРАТОРА) -->
        <div id="react-admin-sidebar" class="admin-sidebar" style="display: none;">
            <div class="admin-header">
                <h3>СТРУКТУРА СТОРІНКИ</h3>
                <button onclick="toggleAdminPanel(false)" style="background:none; border:none; cursor:pointer; padding:0;">
                    <i data-lucide="x" style="width: 18px; height: 18px; color:#aaa;"></i>
                </button>
            </div>
            <div class="admin-edit-btn-box">
                <button id="toggle-edit-mode-btn" class="admin-edit-btn" onclick="toggleEditMode()">
                    <i data-lucide="edit-3" style="width: 16px; height: 16px;"></i> <span id="edit-btn-text">Увімкнути редагування</span>
                </button>
            </div>
            <div class="admin-menu-list">
                <div class="admin-menu-item" onclick="scrollToSection('section-hero')">
                    <span>Hero</span>
