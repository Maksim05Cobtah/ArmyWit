<script>
    // Ініціалізація Lucide Іконок
    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) {
            lucide.createIcons();
        }
        initScrollAnimations();
    });

    // Анімація елементів при скролі
    function initScrollAnimations() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
    }

    // Тимчасова змінна для завантаження зображення
    let activeImageTarget = null;

    function triggerImageChange(imgElement) {
        if (!document.body.classList.contains('is-edit-mode')) return;
        activeImageTarget = imgElement;
        const uploader = document.getElementById('global-image-uploader');
        if (uploader) uploader.click();
    }

    function handleImageUpload(event) {
        const file = event.target.files[0];
        if (file && activeImageTarget) {
            const reader = new FileReader();
            reader.onload = function (e) {
                activeImageTarget.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    }

    // Режим редагування (Edit Mode)
    let isEditMode = false;
    let selectedElement = null;

    function toggleAdminPanel(show) {
        const sidebar = document.getElementById('react-admin-sidebar');
        if (sidebar) sidebar.style.display = show ? 'block' : 'none';
    }

    function toggleEditMode() {
        isEditMode = !isEditMode;
        document.body.classList.toggle('is-edit-mode', isEditMode);
        
        const btnText = document.getElementById('edit-btn-text');
        const btn = document.getElementById('toggle-edit-mode-btn');
        
        if (btnText && btn) {
            if (isEditMode) {
                btnText.innerText = "Вимкнути редагування";
                btn.classList.add('active');
                enableContentEditing(true);
            } else {
                btnText.innerText = "Увімкнути редагування";
                btn.classList.remove('active');
                enableContentEditing(false);
                document.getElementById('inspector-panel').classList.remove('active');
            }
        }
    }

    function enableContentEditing(enable) {
        const editableTexts = document.querySelectorAll('.editable-text');
        editableTexts.forEach(el => {
            el.contentEditable = enable ? "true" : "false";
            if (enable) {
                el.addEventListener('focus', handleElementFocus);
            } else {
                el.removeEventListener('focus', handleElementFocus);
            }
        });

        const draggables = document.querySelectorAll('.draggable-element');
        draggables.forEach(el => {
            el.draggable = enable;
            if (enable) {
                el.addEventListener('dragstart', handleDragStart);
                el.addEventListener('dragend', handleDragEnd);
            } else {
                el.removeEventListener('dragstart', handleDragStart);
                el.removeEventListener('dragend', handleDragEnd);
            }
        });

        initDragContainers(enable);
    }

    function handleElementFocus(e) {
        selectedElement = e.target;
        const inspector = document.getElementById('inspector-panel');
        if (inspector) {
            inspector.classList.add('active');
            const style = window.getComputedStyle(selectedElement);
            document.getElementById('inspector-size').value = parseInt(style.fontSize) || 16;
        }
    }

    function applyStyleToSelected(property, value) {
        if (selectedElement) {
            selectedElement.style[property] = value;
        }
    }

    function scrollToSection(id) {
        const sec = document.getElementById(id);
        if (sec) {
            sec.scrollIntoView({ behavior: 'smooth' });
        }
    }

    function toggleSectionVisibility(event, id) {
        event.stopPropagation();
        const sec = document.getElementById(id);
        if (sec) {
            sec.style.display = sec.style.display === 'none' ? 'block' : 'none';
        }
    }

    // Drag and Drop Функціонал
    function handleDragStart(e) {
        this.classList.add('dragging');
    }

    function handleDragEnd(e) {
        this.classList.remove('dragging');
    }

    function initDragContainers(enable) {
        const containers = document.querySelectorAll('.drag-container');
        containers.forEach(container => {
            if (enable) {
                container.addEventListener('dragover', handleDragOver);
            } else {
                container.removeEventListener('dragover', handleDragOver);
            }
        });
    }

    function handleDragOver(e) {
        e.preventDefault();
        const afterElement = getDragAfterElement(this, e.clientY);
        const draggable = document.querySelector('.dragging');
        if (draggable) {
            if (afterElement == null) {
                this.appendChild(draggable);
            } else {
                this.insertBefore(draggable, afterElement);
            }
        }
    }

    function getDragAfterElement(container, y) {
        const draggableElements = [...container.querySelectorAll('.draggable-element:not(.dragging)')];
        return draggableElements.reduce((closest, child) => {
            const box = child.getBoundingClientRect();
            const offset = y - box.top - box.height / 2;
            if (offset < 0 && offset > closest.offset) {
                return { offset: offset, element: child };
            } else {
                return closest;
            }
        }, { offset: Number.NEGATIVE_INFINITY }).element;
    }



    // Завантаження зображень через input
function handleCertUpload(event) {
    const files = event.target.files;
    const grid = document.getElementById('certificates-grid');

    if (files && files.length > 0) {
        Array.from(files).forEach(file => {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                const card = document.createElement('div');
                card.className = 'cert-card';
                card.setAttribute('onclick', 'openCertModal(this)');
                
                card.innerHTML = `
                    <img src="${e.target.result}" alt="Сертифікат" class="cert-img">
                    <button class="cert-delete-btn" onclick="deleteCert(event, this)">✕</button>
                `;
                
                grid.appendChild(card);
            };
            
            reader.readAsDataURL(file);
        });
    }
}

// Видалення сертифіката
function deleteCert(event, btn) {
    event.stopPropagation(); // Щоб не відкривалося модальне вікно при кліку на хрестик
    const card = btn.closest('.cert-card');
    if (card) {
        card.remove();
    }
}

// Відкриття фото у модальному вікні
function openCertModal(card) {
    const img = card.querySelector('.cert-img');
    const modal = document.getElementById('cert-modal');
    const modalImg = document.getElementById('cert-modal-img');
    
    if (img && modal && modalImg) {
        modalImg.src = img.src;
        modal.style.display = 'flex';
    }
}

// Закриття модального вікна
function closeCertModal() {
    document.getElementById('cert-modal').style.display = 'none';
}


function deleteCert(event, btn) {
    event.stopPropagation(); // Зупиняємо відкриття модального вікна

    // Перевіряємо, чи користувач є адміном (наприклад, за наявністю класу адміна на body або контейнері)
    const isAdmin = document.body.classList.contains('admin-mode') || document.body.classList.contains('is-admin');

    if (!isAdmin) {
        return; // Якщо це звичайний користувач — функція просто не спрацює
    }

    const card = btn.closest('.cert-card');
    if (card && confirm('Ви дійсно хочете видалити цей сертифікат?')) {
        card.remove();
    }
}
</script>