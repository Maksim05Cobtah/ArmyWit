    }// Додавання нової картки в секцію "ПОСЛУГИ ТА ЦІНИ"
async function addServiceToGrid(gridId) {
    // Шукаємо елемент за переданим ID або за замовчуванням 'services-grid'
    const grid = document.getElementById(gridId) || document.getElementById('services-grid');
    if (!grid) return;

    // Шаблонні дані для нового запису в БД
    const newServiceData = {
        name: "НОВА ПОСЛУГА",
        description: "Введіть опис або пункт послуги",
        time: 60,
        price: 1000.00
    };

    try {
        // 1. Відправляємо запит у базу даних
        const response = await fetch('/Services/CreateService', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newServiceData)
        });

        const result = await response.json();

        if (result.success) {
            // 2. Створюємо картку за вашою структурою HTML
            const newCard = document.createElement('div');
            newCard.className = 'service-card draggable-element';
            newCard.setAttribute('data-id', result.id);

            // Режим редагування: якщо isEditMode true, робимо поля доступними для вводу
            const editableAttr = (typeof isEditMode !== 'undefined' && isEditMode) ? 'contenteditable="true"' : 'contenteditable="false"';

            newCard.innerHTML = `
                <div class="card-controls">
                    <button class="admin-btn danger" onclick="removeCard(this)">Видалити</button>
                </div>
                <div>
                    <div class="service-label editable-text" ${editableAttr}>ПОСЛУГА</div>
                    <h3 class="editable-text" ${editableAttr}>${newServiceData.name}</h3>
                    <ul class="service-list bullets">
                        <li class="editable-text" ${editableAttr}>${newServiceData.description}</li>
                    </ul>
                </div>
                <a href="#section-contacts" class="service-price-btn editable-text" ${editableAttr}>1 000 UAH</a>
            `;

            // 3. Додаємо нову картку в сітку
            grid.appendChild(newCard);

            // Якщо режим редагування активний, оновлюємо слухачі подій
            if (typeof enableContentEditing === 'function' && isEditMode) {
                enableContentEditing(true);
            }
        } else {
            alert("Помилка при створенні в БД: " + result.message);
        }
    } catch (error) {
        console.error("Помилка мережі:", error);
    }
}// Автоматичний виклики при завантаженні сторінки
document.addEventListener('DOMContentLoaded', () => {
    loadServicesFromDB();
});

// 1. ПІДВАНТАЖЕННЯ ДАНИХ З БАЗИ
async function loadServicesFromDB() {
    const grid = document.getElementById('services-grid');
    if (!grid) return;

    try {
        const response = await fetch('/Services/GetAll');
        const services = await response.json();

        grid.innerHTML = ''; // Очищаємо контейнер

        services.forEach(service => {
            renderServiceCard(service);
        });
    } catch (error) {
        console.error("Помилка завантаження послуг:", error);
    }
}

// Функція генерації HTML-картки
function renderServiceCard(service) {
    const grid = document.getElementById('services-grid');
    const editableAttr = (typeof isEditMode !== 'undefined' && isEditMode) ? 'contenteditable="true"' : 'contenteditable="false"';

    const card = document.createElement('div');
    card.className = 'service-card draggable-element';
    card.setAttribute('data-id', service.id);

    card.innerHTML = `
        <div class="card-controls">
            <button class="admin-btn danger" onclick="removeCard(this, ${service.id})">Видалити</button>
        </div>
        <div>
            <div class="service-label editable-text" ${editableAttr}>ПОСЛУГА</div>
            <h3 class="editable-text service-name" ${editableAttr}>${service.name}</h3>
            <ul class="service-list bullets">
                <li class="editable-text service-desc" ${editableAttr}>${service.description}</li>
            </ul>
        </div>
        <a href="#section-contacts" class="service-price-btn editable-text service-price" ${editableAttr}>${service.price} UAH</a>
    `;

    // Слухаємо зміни в тексті для автозбереження
    card.querySelectorAll('.editable-text').forEach(element => {
        element.addEventListener('blur', () => saveCardChanges(card));
    });

    grid.appendChild(card);
}

// 2. ДОДАВАННЯ НОВОЇ КАРТКИ В БД ТА НА СТОРІНКУ
async function addServiceToGrid(gridId) {
    const newServiceData = {
        name: "НОВА ПОСЛУГА",
        description: "Опис послуги",
        time: 60,
        price: 1000.00
    };

    try {
        const response = await fetch('/Services/CreateService', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newServiceData)
        });

        const result = await response.json();

        if (result.success) {
            newServiceData.id = result.id;
            renderServiceCard(newServiceData); // Додаємо на сторінку
        }
    } catch (error) {
        console.error("Помилка додавання:", error);
    }
}

// 3. ЗБЕРЕЖЕННЯ ЗМІН ПІСЛЯ РЕДАГУВАННЯ ТЕКСТУ
async function saveCardChanges(cardElement) {
    const id = cardElement.getAttribute('data-id');
    if (!id) return;

    const name = cardElement.querySelector('.service-name')?.innerText.trim() || "";
    const description = cardElement.querySelector('.service-desc')?.innerText.trim() || "";
    const priceRaw = cardElement.querySelector('.service-price')?.innerText.replace('UAH', '').trim() || "0";
    const price = parseFloat(priceRaw) || 0;

    const payload = { name, description, price };

    try {
        await fetch(`/Services/UpdateService/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
    } catch (error) {
        console.error("Помилка збереження змін:", error);
    }
}

// 4. ВИДАЛЕННЯ З БАЗИ ТА СТОРІНКИ
async function removeCard(buttonElement, id) {
    if (!confirm("Ви впевнені, що хочете видалити цю послугу?")) return;

    if (id) {
        try {
            const response = await fetch(`/Services/DeleteService/${id}`, { method: 'DELETE' });
            const result = await response.json();

            if (result.success) {
                buttonElement.closest('.service-card').remove();
            }
        } catch (error) {
            console.error("Помилка видалення:", error);
        }
    } else {
        buttonElement.closest('.service-card').remove();
    }
}

</script>