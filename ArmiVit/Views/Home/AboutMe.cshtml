<!-- SCRIPTS ДЛЯ ФУНКЦІОНАЛУ Конструктора/Редактора -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
        initScrollAnimations();
    });

    /* Анімації при скролі */
    function initScrollAnimations() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
    }

    /* Управління адмін-панеллю */
    function toggleAdminPanel(show) {
        const sidebar = document.getElementById('react-admin-sidebar');
        if (sidebar) sidebar.style.display = show ? 'block' : 'none';
    }

    function scrollToSection(id) {
        const el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth' });
    }

    function toggleSectionVisibility(e, id) {
        e.stopPropagation();
        const section = document.getElementById(id);
        if (section) {
            section.style.display = section.style.display === 'none' ? 'block' : 'none';
            e.target.style.opacity = section.style.display === 'none' ? '0.3' : '1';
        }
    }

    /* Перемикання режиму редагування */
    let isEditMode = false;
    let selectedElement = null;

    function toggleEditMode() {
        isEditMode = !isEditMode;
        document.body.classList.toggle('is-edit-mode', isEditMode);
        document.body.classList.toggle('admin-mode', isEditMode);
        
        const btnText = document.getElementById('edit-btn-text');
        const editBtn = document.getElementById('toggle-edit-mode-btn');
        
        if (isEditMode) {
            btnText.innerText = 'Вимкнути редагування';
            editBtn.classList.add('active');
            enableContentEditing(true);
        } else {
            btnText.innerText = 'Увімкнути редагування';
            editBtn.classList.remove('active');
            enableContentEditing(false);
            hideInspector();
        }
    }

    function enableContentEditing(enable) {
        const editableTexts = document.querySelectorAll('.editable-text');
        editableTexts.forEach(el => {
            el.contentEditable = enable ? "true" : "false";
            if (enable) {
                el.addEventListener('click', handleElementClick);
            } else {
                el.removeEventListener('click', handleElementClick);
            }
        });
    }

    /* Інспектор стилів */
    function handleElementClick(e) {
        if (!isEditMode) return;
        e.stopPropagation();
        selectedElement = e.currentTarget;
        
        const panel = document.getElementById('inspector-panel');
        panel.classList.add('active');

        // Встановлюємо стежені значення
        const computedStyle = window.getComputedStyle(selectedElement);
        document.getElementById('inspector-size').value = parseInt(computedStyle.fontSize);
    }

    function applyStyleToSelected(styleProp, value) {
        if (selectedElement) {
            selectedElement.style[styleProp] = value;
        }
    }

    function hideInspector() {
        const panel = document.getElementById('inspector-panel');
        if (panel) panel.classList.remove('active');
    }

    /* Завантаження зображень */
    let activeImageTarget = null;
    function triggerImageChange(imgEl) {
        if (!isEditMode) return;
        activeImageTarget = imgEl;
        document.getElementById('global-image-uploader').click();
    }

    function handleImageUpload(e) {
        const file = e.target.files[0];
