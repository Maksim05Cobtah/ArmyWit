<script>
    let isEditMode = false;
    let selectedElement = null;

    document.addEventListener("DOMContentLoaded", function () {
        if (window.lucide) {
            lucide.createIcons();
        }

        // Анімації при скролі
        const observerOptions = { root: null, rootMargin: '0px', threshold: 0.15 };
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.animate-on-scroll').forEach(element => {
            observer.observe(element);
        });

        // Слухач для вибору елемента і відкриття інспектора кольорів
        document.addEventListener('click', function (e) {
            if (!isEditMode) return;

            const editable = e.target.closest('.editable-text, .service-card, .certificate-item');
            if (editable) {
                selectedElement = editable;
                const inspector = document.getElementById('inspector-panel');
                if (inspector) {
                    inspector.classList.add('active');
                }
            } else if (!e.target.closest('#inspector-panel') && !e.target.closest('#react-admin-sidebar')) {
                const inspector = document.getElementById('inspector-panel');
                if (inspector) inspector.classList.remove('active');
            }
        });
    });

    // 1. Відкриття / Закриття адмін-панелі
    function toggleAdminPanel(show) {
        const sidebar = document.getElementById('react-admin-sidebar');
        const openBtn = document.getElementById('admin-open-btn');
        if (!sidebar || !openBtn) return;
        
        if (show) {
            sidebar.style.display = 'block';
            openBtn.style.display = 'none';
        } else {
            sidebar.style.display = 'none';
            openBtn.style.display = 'flex';
        }
    }

    // 2. Вмикання / Вимкнення режиму конструктора (Edit Mode)
    function toggleEditMode() {
        isEditMode = !isEditMode;
        const btn = document.getElementById('toggle-edit-mode-btn');
        const btnText = document.getElementById('edit-btn-text');
        
        if (isEditMode) {
            document.body.classList.add('is-edit-mode');
            btn.classList.add('active');
            btnText.innerText = 'Вимкнути редагування';
            enableContentEditable(true);
        } else {
            document.body.classList.remove('is-edit-mode');
            btn.classList.remove('active');
            btnText.innerText = 'Увімкнути редагування';
            enableContentEditable(false);
            const inspector = document.getElementById('inspector-panel');
            if (inspector) inspector.classList.remove('active');
        }
    }

    function enableContentEditable(enable) {
        const editables = document.querySelectorAll('.editable-text');
        editables.forEach(el => {
            el.contentEditable = enable ? "true" : "false";
        });
    }

    // 3. Зміна видимості секцій (Око)
    function toggleSectionVisibility(e, sectionId) {
        e.stopPropagation();
        const section = document.getElementById(sectionId);
        if (!section) return;

        if (section.style.display === 'none') {
            section.style.display = 'block';
            e.target.style.opacity = '1';
        } else {
            section.style.display = 'none';
            e.target.style.opacity = '0.3';
        }
    }

    // 4. Швидкий скрол
    function scrollToSection(sectionId) {
        const element = document.getElementById(sectionId);
        if (element) {
            element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // 5. Зміна джерела фото у режимі конструктора
    function changeImageSrc(imgEl) {
        if (!isEditMode) return;
        const newSrc = prompt("Введіть нове посилання на зображення (URL):", imgEl.src);
        if (newSrc) {
            imgEl.src = newSrc;
        }
    }

    // 6. Видалення картки
    function deleteCard(btn) {
        if (!isEditMode) return;
        const card = btn.closest('.service-card, .certificate-item, .support-card-item, .contact-item');
        if (card && confirm("Видалити цю картку?")) {
            card.remove();
        }
    }

    // 7. Додавання картки у сітку
    function addCardToGrid(e, gridId) {
        e.stopPropagation();
        if (!isEditMode) {
            alert("Спочатку увімкніть режим редагування!");
            return;
        }
        const grid = document.getElementById(gridId);
        if (!grid) return;

        if (gridId === 'services-grid') {
            const newCard = document.createElement('div');
            newCard.className = 'service-card animate-on-scroll is-visible';
            newCard.innerHTML = `
                <div class="card-controls"><button class="card-btn-delete" onclick="deleteCard(this)">×</button></div>
                <div>
                    <h3 class="editable-text" contenteditable="true">НОВА ПОСЛУГА</h3>
                    <div class="service-label editable-text" contenteditable="true">ТИ ОТРИМАЄШ:</div>
                    <ul class="service-list bullets">
                        <li class="editable-text" contenteditable="true">опис пункту 1</li>
                        <li class="editable-text" contenteditable="true">опис пункту 2</li>
                    </ul>
                </div>
                <div class="service-price-btn editable-text" contenteditable="true">0000ГРН</div>
            `;
            grid.appendChild(newCard);
        } else if (gridId === 'certificates-grid') {
            const newCard = document.createElement('div');
            newCard.className = 'certificate-item animate-on-scroll is-visible';
            newCard.innerHTML = `
                <div class="card-controls"><button class="card-btn-delete" onclick="deleteCard(this)">×</button></div>
                <p class="editable-text" contenteditable="true">НОВИЙ СЕРТИФІКАТ</p>
            `;
            grid.appendChild(newCard);
        }
    }

    // 8. Застосування кольорів і розмірів шрифту з Інспектора
    function applyStyleToSelected(styleProp, value) {
        if (selectedElement && value) {
            selectedElement.style[styleProp] = value;
        }
    }
</script>