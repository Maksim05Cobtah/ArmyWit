@using ArmiVit.Models.ViewsModel
@model ProductViewModel

@{
    ViewData["Title"] = "HealthMarket";
}

<div class="hero">
    <div class="hero-text">
        <h1>Здоровʼя кожного дня</h1>
        <p>Вітаміни, БАДи та товари для вашого самопочуття</p>
        <button class="primary-btn">Перейти в каталог</button>
    </div>
</div>

<div class="container">
    <div class="search-box">
        <form id="searchForm" asp-controller="Home" asp-action="Index" method="get" class="search-form">
            <div class="search-group">
                <input type="text"
                       id="searchInput"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="search-input"
                       placeholder="Введіть назву товару або ключове слово" />
                <button type="submit" class="search-btn">Пошук</button>
            </div>
        </form>
    </div>

    <h2 class="section-title">Категорії</h2>

    <div class="categories">
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="Home" asp-action="Category" asp-route-id="@category.Id">
                <div class="category-card">
                    @category.Name
                </div>
            </a>
        }
    </div>

    <h2 class="section-title">Популярні товари</h2>

    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="products">
            @foreach (var product in Model.Products)
            {
                <div class="product-card">
                    @* Тег <a> тепер огортає весь вміст картки *@
                    <a asp-controller="Home" asp-action="Pigeon" asp-route-id="@product.Id" class="product-item-link">
                        <div class="img-placeholder">
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="~/images/@product.ImagePath" alt="@product.Name" />
                            }
                        </div>

                        <h3>@product.Name</h3>
                        <p>@product.Description</p>

                        <div class="price">
                            @product.Price ₴
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <p class="search-empty">Товар не знайдено</p>
    }

    <p class="disclaimer">
        ⚠ Інформація на сайті не є медичною консультацією
    </p>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    let searchTimeout;

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimeout);

            if (this.value.trim() === '') {
                searchTimeout = setTimeout(() => {
                    window.location.href = '/Home/Index';
                }, 300);
            }
        });
    }
</script>

@* Додамо трохи стилів, щоб посилання не псувало дизайн *@
<style>
    .product-item-link {
        text-decoration: none;
        color: inherit;
        display: block;
        height: 100%;
    }
    .product-card:hover {
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        cursor: pointer;
    }
</style>