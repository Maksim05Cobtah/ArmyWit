@using ArmiVit.Models.ViewsModel
@{
    ViewData["Title"] = "HealthMarket";
}
@model ProductViewModel

<div class="hero">
    <div class="hero-text">
        <h1>Здоровʼя кожного дня</h1>
        <p>Вітаміни, БАДи та товари для вашого самопочуття</p>
        <button class="primary-btn">Перейти в каталог</button>
    </div>
</div>

<div class="container">

    <h2 class="section-title">Категорії</h2>

    <div class="categories">

        @foreach (var category in Model.Categories)
        {
            <div class="category-card">
                @category.Name
            </div>
        }

    </div>


    <h2 class="section-title">Популярні товари</h2>

    <div class="products">

        @foreach (var product in Model.Products)
        {

            <div class="product-card">

                <div class="img-placeholder">

                    @if (!string.IsNullOrEmpty(product.ImagePath))
                    {
                        <img src="~/images/@product.ImagePath" />
                    }

                </div>

                <h3>@product.Name</h3>

                <p>
                    @product.Description
                </p>

                <div class="price">
                    @product.Price ₴
                </div>

                <button>
                    Купити
                </button>

            </div>

        }

    </div>

    <p class="disclaimer">
        ⚠ Інформація на сайті не є медичною консультацією
    </p>

</div>