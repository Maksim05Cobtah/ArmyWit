@model ArmiVit.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container">
    <div class="product-details" style="margin-top: 50px; display: flex; gap: 30px; align-items: start;">

        <div class="product-image" style="flex: 1; max-width: 500px;">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="~/images/@Model.ImagePath" alt="@Model.Name" style="width: 100%; border-radius: 10px;" />
            }
            else
            {
                <div style="width: 100%; height: 300px; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                    Немає фото
                </div>
            }
        </div>

        <div class="product-info" style="flex: 1;">
            <nav style="margin-bottom: 20px;">
                <a asp-controller="Home" asp-action="Index" style="color: #666; text-decoration: none;">← Назад до каталогу</a>
            </nav>

            <h1 style="font-size: 2.5rem; margin-bottom: 20px;">@Model.Name</h1>

            <div class="description" style="font-size: 1.1rem; line-height: 1.6; color: #444; margin-bottom: 30px;">
                @Model.Description
            </div>

            <div class="price" style="font-size: 2rem; font-weight: bold; color: #2ecc71; margin-bottom: 20px;">
                @Model.Price ₴
            </div>

           
        </div>

    </div>
</div>