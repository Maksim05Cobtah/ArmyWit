<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArmiVit</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Product.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AboutMe.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Product,css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArmiVit.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
    
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

<div class="page-wrapper">

        <header>
            <nav class="premium-navbar navbar navbar-expand-lg">

                <div class="container-fluid px-4">

                    <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">

                        <div class="brand-icon">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>

                        <div class="brand-text">
                            <h3>ArmiVit</h3>
                            <span>Здоров'я кожного дня</span>
                        </div>

                    </a>

                    <button class="navbar-toggler border-0 shadow-none"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbar">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="collapse navbar-collapse" id="navbar">

                        <ul class="navbar-nav mx-auto">

                            <li class="nav-item">
                                <a class="nav-link active"
                                       asp-controller="Home"
                                       asp-action="Index">
                                    Головна
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                       asp-controller="Home"
                                       asp-action="Privacy">
                                    Про нас
                                </a>
                            </li>

                        </ul>

                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <div class="admin-buttons">

                                <a asp-controller="Categories"
                                       asp-action="AddCategories"
                                       class="admin-btn">
                                    Категорія
                                </a>

                                <a asp-controller="Products"
                                       asp-action="AddProducts"
                                       class="admin-btn">
                                    Продукт
                                </a>

                            </div>
                        }

                    </div>

                </div>

            </nav>
        </header>

    <main class="content container pb-3">
        @RenderBody()
    </main>

        <footer class="premium-footer">

            <div class="container">

                <div class="footer-content">

                    <div class="footer-brand">

                        <div class="footer-logo">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>

                        <div>

                            <h3>ArmiVit</h3>
                            <p>Здоров'я кожного дня</p>

                        </div>

                    </div>

                    <div class="footer-links">

                        <a asp-controller="Home" asp-action="Index">
                            Головна
                        </a>

                        <a asp-controller="Home" asp-action="Privacy">
                            Про нас
                        </a>

                    </div>

                    <div class="footer-social">

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-telegram"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-phone"></i>
                        </a>

                    </div>

                </div>

                <div class="footer-bottom">

                    © @DateTime.Now.Year ArmiVit. Всі права захищені.

                </div>

            </div>

        </footer>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
